# Redis Monitor Agent 生产环境配置模板
# 部署时复制到 /etc/redis-monitor-agent/agent.env，并由 root 设置为 600 权限。

# 平台连接信息
AGENT_PLATFORM_URL=http://platform-host:8100
AGENT_REGISTER_CODE=
AGENT_NAME=

# Agent 自身目录与监听端口
AGENT_SERVER_PORT=9101
AGENT_ROOT=/opt/redis-monitor-agent
AGENT_SCRIPT_DIR=/opt/redis-monitor-agent/scripts
AGENT_STATE_DIR=/opt/redis-monitor-agent/state
AGENT_TOKEN_FILE=/opt/redis-monitor-agent/agent-token.dat
AGENT_UPGRADE_DIR=/tmp/redis-upgrade/
AGENT_VERSION_PACKAGE_MAX_BYTES=536870912
AGENT_CONFIG_FILE_MAX_BYTES=10485760

# Redis 安装布局和 systemd 单元名称
AGENT_REDIS_ROOT=/opt/redis
AGENT_REDIS_RELEASES_DIR=/opt/redis/releases
AGENT_REDIS_CURRENT_LINK=/opt/redis/current
AGENT_REDIS_CONFIG_DIR=/etc/redis
AGENT_REDIS_DATA_DIR=/opt/redis/data
AGENT_REDIS_SERVICE=redis-server.service

# Redis 本地连接信息
AGENT_REDIS_HOST=127.0.0.1
AGENT_REDIS_PORT=6379
AGENT_REDIS_PASSWORD=
AGENT_REDIS_DB=0
AGENT_REDIS_TIMEOUT=2000

# Sentinel 本地连接信息
AGENT_SENTINEL_SERVICE=redis-sentinel.service
AGENT_SENTINEL_HOST=127.0.0.1
AGENT_SENTINEL_PORT=26379
AGENT_SENTINEL_PASSWORD=
AGENT_SENTINEL_MASTER_NAME=mymaster
AGENT_SENTINEL_TIMEOUT=2000

# 故障恢复配置：备份文件与服务实际读取的目标文件
AGENT_RECOVERY_REDIS_BACKUP_FILE=/backup/redis-config/redis.conf.bak
AGENT_RECOVERY_SENTINEL_BACKUP_FILE=/backup/redis-config/sentinel.conf.bak
AGENT_RECOVERY_REDIS_TARGET_FILE=/etc/redis/redis.conf
AGENT_RECOVERY_SENTINEL_TARGET_FILE=/etc/redis/sentinel.conf

# 采集周期 5 分钟；心跳固定 30 秒。平台超过 60 秒未收到心跳时判定离线。
AGENT_COLLECT_INTERVAL=300000
AGENT_HEARTBEAT_INTERVAL=30000
